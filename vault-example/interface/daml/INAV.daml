module INAV where

data NAVInfo = NAVInfo with
  vaultId : Text
  manager : Party
  nav : Decimal
  totalShares : Decimal
  sharePrice : Decimal
  updatedAt : Time
    deriving (Eq, Show)

interface INAV where
  viewtype NAVInfo
