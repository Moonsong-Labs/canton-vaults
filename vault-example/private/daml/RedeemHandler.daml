module RedeemHandler where

import IFee
import IRedeemHandler
import NAV
import RedeemRequest (redemptionAmount)
import Vault (Vault(..))

template RedeemHandler
  with
    vaultId : Text
    manager : Party
    feeCid : ContractId IFee
  where
    signatory manager
    ensure vaultId /= ""

    interface instance IRedeemHandler for RedeemHandler where
      view = RedeemHandlerInfo with vaultId, manager

      -- Vault invokes this under a manager-only exercise. The holder's public
      -- settlement receives the quote after the private valuation is complete.
      handleRedeem instrumentId shares = do
        (_, vault) <- fetchByKey @Vault (manager, vaultId)
        (navCid, nav) <- fetchByKey @NAV (manager, vaultId)
        assertMsg "redeem instrument does not match vault" (instrumentId == vault.acceptedInstrument)
        assertMsg "redeem shares must be positive and within the supply"
          (shares > 0.0 && shares <= nav.totalShares)
        feeInfo <- view <$> fetch feeCid
        assertMsg "fee model belongs to another manager" (feeInfo.manager == manager)
        let (sharePrice, amount) = priceRedemption nav.nav nav.totalShares shares
        fee <- exercise feeCid CalculateFee with amount
        exercise navCid UpdateNAV with
          newNav = nav.nav - amount
          newTotalShares = nav.totalShares - shares
        pure RedeemQuote with amount, fee, sharePrice

-- Price and gross payout for redeeming `shares`. The last redemption drains NAV
-- exactly; partial payouts round down at the redemption price.
priceRedemption : Decimal -> Decimal -> Decimal -> (Decimal, Decimal)
priceRedemption nav totalShares shares =
  let sharePrice = redeemSharePrice nav totalShares
  in (sharePrice, if shares == totalShares then nav else redemptionAmount shares sharePrice)
