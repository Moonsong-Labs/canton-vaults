module FlatFee where

import IFee

-- One USDCx, reusable by deposit and redeem handlers. Capping it at half the amount
-- lets small holdings and the last holder redeem.
template FlatFee
  with manager : Party
  where
    signatory manager

    interface instance IFee for FlatFee where
      view = FeeInfo with manager
      calculateFee amount = min 1.0 (amount / 2.0)
