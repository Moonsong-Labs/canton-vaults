module NAV where

import DA.Numeric qualified as Numeric
import IVault (VaultKey)
import INAV

template NAV
  with
    vaultId : Text
    manager : Party
    nav : Decimal
    totalShares : Decimal
    updatedAt : Time
    auditors : [Party]
  where
    signatory manager
    observer auditors
    ensure
      vaultId /= ""
        && nav >= 0.0
        && totalShares >= 0.0
        && (totalShares > 0.0 || nav == 0.0)
        && nav <= pricingLimit && totalShares <= pricingLimit
        && redeemSharePrice nav totalShares >= minSharePrice

    -- Updates retain this identity; the manager must avoid duplicate initial snapshots.
    key (manager, vaultId) : VaultKey
    maintainer key._1

    interface instance INAV for NAV where
      view = NAVInfo with
        vaultId, manager, nav, totalShares, updatedAt
        sharePrice = pricePerShare nav totalShares

    choice UpdateNAV : ContractId NAV
      with
        newNav : Decimal
        newTotalShares : Decimal
      controller manager
      do
        now <- getTime
        create this with
          nav = newNav
          totalShares = newTotalShares
          updatedAt = now

-- Pricing multiplies price by supply exactly in Numeric 20, which holds values
-- below 1e18; bounding NAV and supply keeps that product in range.
pricingLimit : Decimal
pricingLimit = 100_000_000_000_000_000.0

-- The lowest redemption price a valuation may set. At 1e-6 the 10-decimal price
-- keeps at least five significant figures, so rounding moves it by at most 1e-4.
minSharePrice : Decimal
minSharePrice = 0.000001

-- Empty vaults start at one unit per share. The view reports this price rounded
-- to nearest; deposits and redemptions use the directed prices below.
pricePerShare : Decimal -> Decimal -> Decimal
pricePerShare nav totalShares =
  if totalShares == 0.0 then 1.0
  else either error identity do
    assertMsg "total shares must be positive" (totalShares > 0.0)
    pure (nav / totalShares)

-- Deposits round the price up and redemptions round it down, so rounding never
-- moves value away from outstanding shares. The checks compare exact products.
depositSharePrice : Decimal -> Decimal -> Decimal
depositSharePrice nav totalShares =
  let price = pricePerShare nav totalShares
  in if Numeric.mul @20 price totalShares < Numeric.cast @20 nav
    then price + 0.0000000001
    else price

redeemSharePrice : Decimal -> Decimal -> Decimal
redeemSharePrice nav totalShares =
  let price = pricePerShare nav totalShares
  in if Numeric.mul @20 price totalShares > Numeric.cast @20 nav
    then price - 0.0000000001
    else price
