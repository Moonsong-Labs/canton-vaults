module DepositHandler where

import DA.Text qualified as Text
import VaultLimits (maxVaultIdLength)

import IDepositHandler
import IFee
import NAV
import Vault (Vault(..))

template DepositHandler
  with
    vaultId : Text
    manager : Party
    feeCid : ContractId IFee
  where
    signatory manager
    ensure vaultId /= "" && Text.length vaultId <= maxVaultIdLength

    interface instance IDepositHandler for DepositHandler where
      view = DepositHandlerInfo with vaultId, manager

      -- VaultAccess invokes this under a manager-only exercise. Valuation and
      -- supply updates remain private while the quote feeds public settlement.
      handleDeposit instrumentId amount = do
        assertMsg "deposit amount must be positive" (amount > 0.0)
        (_, vault) <- fetchByKey @Vault (manager, vaultId)
        (navCid, nav) <- fetchByKey @NAV (manager, vaultId)
        assertMsg "deposit instrument does not match vault"
          (vault.acceptedInstrument == instrumentId)
        feeInfo <- view <$> fetch feeCid
        assertMsg "fee model belongs to another manager" (feeInfo.manager == manager)
        fee <- exercise feeCid CalculateFee with amount
        let netAmount = amount - fee
            (sharePrice, shares) = priceDeposit nav.nav nav.totalShares netAmount
        assertMsg "deposit must issue positive shares" (shares > 0.0)

        -- A later settlement failure rolls back this update in the same transaction.
        exercise navCid UpdateNAV with
          newNav = nav.nav + netAmount
          newTotalShares = nav.totalShares + shares
        pure DepositQuote with fee, sharePrice, shares

-- Price and shares issued for a net deposit, priced rounded up so new shares
-- never dilute existing holders.
priceDeposit : Decimal -> Decimal -> Decimal -> (Decimal, Decimal)
priceDeposit nav totalShares netAmount =
  let sharePrice = depositSharePrice nav totalShares
  in (sharePrice, sharesForDeposit netAmount sharePrice)
