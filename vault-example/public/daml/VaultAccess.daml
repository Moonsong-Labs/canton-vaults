module VaultAccess where

import Splice.Api.Token.HoldingV2
import IAccessAttestation (IAccessAttestation)
import IVaultAccess

-- Consumers must fetch the attestation and validate its parties and vault scope.
template VaultAccess
  with
    vaultId : Text
    manager : Party
    depositor : Party
    attestationCid : ContractId IAccessAttestation
    acceptedInstrument : InstrumentId
    treasury : Account
  where
    signatory manager
    observer depositor
    ensure vaultId /= "" && acceptedInstrument.id /= "" && treasury.owner == Some manager

    interface instance IVaultAccess for VaultAccess where
      view = VaultAccessInfo with vaultId, manager, depositor, attestationCid, acceptedInstrument, treasury

    choice Revoke : ()
      controller manager
      do return ()
