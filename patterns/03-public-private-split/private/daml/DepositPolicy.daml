module DepositPolicy where

import IDepositPolicy

template DepositPolicy
  with
    manager : Party
    maxDeposit : Decimal
  where
    signatory manager
    ensure maxDeposit > 0.0

    interface instance IDepositPolicy for DepositPolicy where
      view = DepositPolicyView with manager

      checkDeposit amount = do
        assertMsg "deposit amount must be positive" (amount > 0.0)
        assertMsg "deposit exceeds the private policy limit" (amount <= maxDeposit)
        pure ()
