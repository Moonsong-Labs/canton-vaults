module IDepositHandler where

data DepositHandlerInfo = DepositHandlerInfo with
  manager : Party
    deriving (Eq, Show)

interface IDepositHandler where
  viewtype DepositHandlerInfo

  handleDeposit : Decimal -> Update ()
