module Tests.DepositTest where

import Daml.Script
import DepositRequest
import DepositHandler
import IDepositHandler
import VaultAccess

testDeposit : Script ()
testDeposit = script do
  manager <- allocateParty "manager"
  depositor <- allocateParty "depositor"
  let vaultId = "vault-1"

  -- The manager grants vault access and configures its private deposit limit.
  accessCid <- submit manager $ createCmd VaultAccess with manager; depositor; vaultId
  handlerCid <- submit manager $ createCmd DepositHandler with manager; maxDeposit = 2000.0
  handler <- queryContractId depositor handlerCid
  assertMsg "handler is private to the manager" (handler == None)

  -- The depositor uses the access contract to create a pending DepositRequest.
  -- No funds move at this stage.
  requestCid <- submit depositor $ exerciseCmd accessCid Deposit with amount = 1500.0

  -- Processing belongs to the manager; the depositor can only propose the deposit.
  submitMustFail depositor $ exerciseCmd accessCid HandleDeposit with
    requestCid; handlerCid = toInterfaceContractId @IDepositHandler handlerCid

  -- HandleDeposit invokes the interface method implemented by the private handler.
  -- If the limit check passes, Accept consumes the request and creates the receipt
  -- within the same transaction.
  result <- submit manager $ exerciseCmd accessCid HandleDeposit with
    requestCid; handlerCid = toInterfaceContractId @IDepositHandler handlerCid

  -- The receipt is the public outcome shared by both parties. A full vault would
  -- settle the assets and issue shares here; this pattern only records acceptance.
  assertMsg "accept returns the settled amount" (result == 1500.0)
  receipts <- query @DepositReceipt depositor
  assertMsg "depositor receives the public receipt"
    (map snd receipts == [DepositReceipt with manager; depositor; vaultId; amount = 1500.0])
  managerReceipts <- query @DepositReceipt manager
  assertMsg "both parties see the same receipt" (managerReceipts == receipts)

  -- The request is consumed; access and the private handler remain reusable.
  pending <- queryContractId depositor requestCid
  assertMsg "settlement consumes the request" (pending == None)
  Some _ <- queryContractId manager handlerCid
  Some _ <- queryContractId depositor accessCid
  pure ()

testDepositLimit : Script ()
testDepositLimit = script do
  manager <- allocateParty "manager"
  depositor <- allocateParty "depositor"
  let vaultId = "vault-1"
  accessCid <- submit manager $ createCmd VaultAccess with manager; depositor; vaultId
  handlerCid <- submit manager $ createCmd DepositHandler with manager; maxDeposit = 2000.0

  -- Request creation succeeds even above the limit, which is checked during processing.
  requestCid <- submit depositor $ exerciseCmd accessCid Deposit with amount = 2500.0

  -- A failed private check leaves the proposal available for cancellation.
  submitMustFail manager $ exerciseCmd accessCid HandleDeposit with
    requestCid; handlerCid = toInterfaceContractId @IDepositHandler handlerCid
  receipts <- query @DepositReceipt depositor
  assertMsg "failed acceptance creates no receipt" (null receipts)
  submit depositor $ exerciseCmd requestCid Cancel

testDepositRequiresPositiveAmount : Script ()
testDepositRequiresPositiveAmount = script do
  manager <- allocateParty "manager"
  depositor <- allocateParty "depositor"
  accessCid <- submit manager $ createCmd VaultAccess with manager; depositor; vaultId = "vault-1"

  -- The choice rejects non-positive amounts before creating a request.
  mustRejectDeposit =<< trySubmit depositor (exerciseCmd accessCid Deposit with amount = 0.0)
  mustRejectDeposit =<< trySubmit depositor (exerciseCmd accessCid Deposit with amount = -1.0)
  -- Direct request creation remains protected by the ensure clause.
  mustViolateEnsure =<< trySubmit depositor
    (createCmd DepositRequest with manager; depositor; vaultId = "vault-1"; amount = 0.0)
  -- Both signatories could create a receipt directly, so its invariant lives in ensure.
  mustViolateEnsure =<< trySubmit (actAs [manager, depositor])
    (createCmd DepositReceipt with manager; depositor; vaultId = "vault-1"; amount = 0.0)
  mustViolateEnsure =<< trySubmit (actAs [manager, depositor])
    (createCmd DepositReceipt with manager; depositor; vaultId = ""; amount = 1.0)

mustRejectDeposit : Show a => Either SubmitError a -> Script ()
mustRejectDeposit result = case result of
  Left (FailureStatusError status)
    | status.errorId == "UNHANDLED_EXCEPTION/DA.Exception.AssertionFailed:AssertionFailed"
      && status.message == "deposit amount must be positive" -> pure ()
  _ -> abort ("expected the deposit amount assertion to fail, got: " <> show result)

mustViolateEnsure : Show a => Either SubmitError a -> Script ()
mustViolateEnsure result = case result of
  Left (FailureStatusError status)
    | status.errorId == "UNHANDLED_EXCEPTION/DA.Exception.PreconditionFailed:PreconditionFailed" -> pure ()
  _ -> abort ("expected an ensure clause to fail, got: " <> show result)
