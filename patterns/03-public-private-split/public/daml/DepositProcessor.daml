module DepositProcessor where

import DepositRequest
import IDepositPolicy

template DepositProcessor
  with
    manager : Party
    depositor : Party
    policyCid : ContractId IDepositPolicy
  where
    signatory manager
    observer depositor

    -- As a root nonconsuming exercise, Accept informs only the manager.
    -- A depositor-visible parent exercise would also expose the policy branch.
    nonconsuming choice Accept : Decimal
      with
        requestCid : ContractId DepositRequest
      controller manager
      do
        terms <- fetch requestCid
        assertMsg "deposit belongs to another manager" (terms.manager == manager)
        assertMsg "deposit belongs to another depositor" (terms.depositor == depositor)
        exercise policyCid CheckDeposit with
          amount = terms.amount
        -- Settle is a sibling of CheckDeposit, so its witnesses see the public branch.
        exercise requestCid Settle
