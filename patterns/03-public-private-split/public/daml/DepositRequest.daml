module DepositRequest where

-- The proposal fixes the amount the manager may accept.
template DepositRequest
  with
    manager : Party
    depositor : Party
    vaultId : Text
    amount : Decimal
  where
    signatory depositor
    observer manager
    ensure vaultId /= "" && amount > 0.0

    -- The signed request supplies the depositor's authority for the receipt.
    choice Consume : Decimal
      controller manager
      do
        create DepositReceipt with manager; depositor; vaultId; amount
        pure amount

    choice Cancel : ()
      controller depositor
      do pure ()

    choice Reject : ()
      controller manager
      do pure ()

template DepositReceipt
  with
    manager : Party
    depositor : Party
    vaultId : Text
    amount : Decimal
  where
    signatory manager, depositor
