module DepositInfo where

import Splice.Api.Token.HoldingV2 (Account, InstrumentId)

data DepositView = DepositView with
  vaultId : Text
  manager : Party
  acceptedInstrument : InstrumentId
  treasury : Account
  minDeposit : Decimal
    deriving (Eq, Show)

interface DepositInfo where
  viewtype DepositView
